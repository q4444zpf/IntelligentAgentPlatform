FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
# Docker Socket permissions are controlled by the staging host; this service is
# isolated behind the sandbox profile and is the only component allowed access.
USER root
EXPOSE 8091
CMD ["python", "-m", "uvicorn", "app.runtime.launcher_service:app", "--host", "0.0.0.0", "--port", "8091"]
