IAP_ALLOW_DEV_IDENTITY=false
IAP_PROJECT_SKILLS_API_ENABLED=false
# Enable only after configuring each physical asset executor and its secret.
IAP_CONTROL_GATEWAY_ENABLED=false
IAP_CONTROL_EXECUTORS_JSON={"reservoir":{"base_url":"https://control.example/api","token_env":"IAP_CONTROL_EXECUTOR_RESERVOIR_TOKEN","timeout_seconds":10}}
IAP_CONTROL_EXECUTOR_RESERVOIR_TOKEN=change-me
# Alternatively set IAP_CONTROL_EXECUTOR_RESERVOIR_TOKEN_FILE, never both.
# Migration tests require a separate PostgreSQL database whose name contains test.
# Leave unset to intentionally skip PostgreSQL tests; never reuse DATABASE_URL.
# TEST_DATABASE_URL=postgresql+psycopg://test_user:change-me@127.0.0.1:5432/iap_migration_test
DATABASE_URL=postgresql+psycopg://postgres:change-me@192.168.0.199:40001/iap
IAP_OBJECT_STORAGE_ENDPOINT=http://minio:9000
IAP_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
IAP_OBJECT_STORAGE_ACCESS_KEY=iap-access
IAP_OBJECT_STORAGE_SECRET_KEY=change-me-minio-secret
IAP_ARTIFACT_BUCKET=iap-artifacts
IAP_SKILL_BUCKET=iap-skills
IAP_WORKFLOW_RUNNER_URL=http://workflow-runner:8090
IAP_WORKFLOW_RUNNER_SANDBOX_ENABLED=false
IAP_RUNNER_GATEWAY_URL=http://api:8000/internal/runner
IAP_RUNNER_TOKEN_SIGNING_KEY=change-me-at-least-32-characters
# Required only for the controlled sandbox-launcher staging profile.
IAP_RUNNER_LAUNCHER_TOKEN=
IAP_SANDBOX_LAUNCHER_URL=http://sandbox-launcher:8091
IAP_SANDBOX_RUNNER_IMAGE=iap/workflow-runner:latest
IAP_SANDBOX_IMAGE_TRUSTED=false
IAP_SANDBOX_NON_ROOT=false
IAP_SANDBOX_READ_ONLY_ROOT=false
IAP_SANDBOX_RUNNER_GATEWAY_NETWORK=false
IAP_RUNNER_GATEWAY_NETWORK=intelligent-agent-platform_runner-gateway
IAP_SANDBOX_RESOURCE_LIMITS=false
IAP_SANDBOX_CLEANUP_GUARANTEED=false
VITE_API_BASE_URL=/api
# Local development identity only; use non-sensitive fixture identifiers.
VITE_DEV_UNIT_ID=change-me
VITE_DEV_PROJECT_ID=change-me
VITE_DEV_USER_ID=change-me
# Comma-separated: user, project_admin, unit_auditor.
VITE_DEV_USER_ROLES=user
